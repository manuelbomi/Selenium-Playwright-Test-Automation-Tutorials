# Copy this file to .env and fill in real values. .env is gitignored -- never
# commit real credentials, even for a public demo app like saucedemo.com.
# Mirrors the .env pattern used in Tutorial 3 (Selenium advanced patterns) so
# config/secrets handling is consistent across the whole series.

# Base URL of the application under test
BASE_URL=https://www.saucedemo.com

# saucedemo.com's public "standard" test user (safe to keep as-is for this
# tutorial; in a real project these would be a dedicated test account's
# credentials, injected via CI secrets, never checked into source control)
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce
