# .env.example — documented template for local configuration.
#
# HOW TO USE:
#   1. Copy this file to `.env` in the same folder:  cp .env.example .env
#   2. Fill in real values in `.env` if you need something other than the
#      public demo defaults below.
#   3. `.env` is listed in .gitignore — it must NEVER be committed. This
#      .env.example file is the thing that gets committed, precisely
#      because it contains no real secrets, only placeholders/safe demo
#      values.
#
# NEVER hardcode credentials, tokens, or environment URLs inside test code
# or page objects. Everything below is read exclusively through config.py.

# Application under test.
BASE_URL=https://www.saucedemo.com

# Public demo site used for iframe / alert / window / upload examples.
WIDGETS_URL=https://the-internet.herokuapp.com

# chrome | firefox | edge
BROWSER=chrome

# true/false — run the browser without a visible UI (required in CI/containers).
HEADLESS=false

# saucedemo's "standard_user" / "secret_sauce" are public demo credentials,
# not real secrets — but we route them through env vars anyway so the
# pattern is identical to what you'd do with a real login. In a real
# project these values would live in a secrets manager (GitHub Actions
# Secrets, Vault, AWS Secrets Manager, etc.), never in source control.
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce

# Seconds an explicit WebDriverWait will poll before timing out.
EXPLICIT_WAIT=10

# Leave empty to run against local browser binaries. Set to a Selenium Grid
# hub URL (e.g. http://localhost:4444/wd/hub) to run against Grid/Docker/CI.
SELENIUM_GRID_URL=

# Directory (relative to this tutorial's folder) where failure screenshots,
# page-source dumps, and console logs are written.
ARTIFACTS_DIR=artifacts
